@page "/envanter/{Id:guid}"
@inject Api Api
@inject Session Session
@inject Toasts Toasts
@inject NavigationManager Nav

<PageTitle>@(item?.Tag ?? "Envanter") · Nurol Envanter</PageTitle>
@if (error is not null && item is null) { <ErrorNote Error="error" /> }
else if (item is null) { <div class="loading">Yükleniyor…</div> }
else
{
    var canWrite = Session.CanWrite;
    <div class="head">
        <div class="t">
            <div class="crumb"><a href="envanter">Envanter</a> / @item.CategoryName</div>
            <h1 style="font-family:var(--mono)">@item.Tag</h1>
            <p>@item.ManufacturerName @item.ModelName · <StatusPill Status="item.Status" /></p>
        </div>
        <button class="btn" @onclick="() => labels = true">Etiket</button>
        @if (canWrite)
        {
            @switch (item.Status)
            {
                case ItemStatus.InStock:
                    <button class="btn" @onclick='() => Open("maintenance")'>Bakıma al</button>
                    <button class="btn danger" @onclick='() => Open("retire")'>Kullanım dışı bırak</button>
                    <a class="btn" href="transferler/yeni?cihaz=@item.Id">Transfere ekle</a>
                    <a class="btn" href="envanter/@item.Id/duzenle">Düzenle</a>
                    <a class="btn pri" href="zimmetler/yeni?cihaz=@item.Id">Zimmetle</a>
                    break;
                case ItemStatus.Assigned:
                    <a class="btn" href="envanter/@item.Id/duzenle">Düzenle</a>
                    <a class="btn" href="zimmetler/iade?personel=@item.EmployeeId&cihaz=@item.Id">İade al</a>
                    <a class="btn pri" href="zimmetler/devir?personel=@item.EmployeeId&cihaz=@item.Id">Başka personele devret</a>
                    break;
                case ItemStatus.InMaintenance:
                    <a class="btn" href="envanter/@item.Id/duzenle">Düzenle</a>
                    <button class="btn pri" @onclick='() => Open("maintenance/end")'>Bakımdan döndü</button>
                    break;
                case ItemStatus.Retired:
                    <button class="btn" @onclick='() => Open("reactivate")'>Tekrar kullanıma al</button>
                    break;
            }
        }
    </div>
    @if (item.Status == ItemStatus.InTransit)
    {
        <div class="note warn"><b>Transferde:</b> cihaz hedef depoda teslim alınana kadar zimmet, bakım veya başka transfer işlemine konu olamaz. <a href="transferler">Transferler</a></div>
    }
    @if (item.Status == ItemStatus.InMaintenance && item.MaintenanceNote is not null)
    {
        <div class="note warn"><b>Bakımda:</b> @item.MaintenanceNote</div>
    }

    <div class="grid g2">
        <section class="card">
            <div class="ch"><h2>Bilgiler</h2></div>
            <div class="cb">
                <dl class="kv">
                    <dt>Envanter etiketi</dt><dd class="mono">@item.Tag</dd>
                    <dt>Kategori</dt><dd>@item.CategoryName</dd>
                    <dt>Marka / model</dt><dd>@item.ManufacturerName @item.ModelName</dd>
                    <dt>Seri numarası</dt><dd class="mono">@(item.Serial ?? "—")</dd>
                    <dt>Şirket</dt><dd>@item.CompanyName</dd>
                    <dt>Depo / lokasyon</dt><dd>@item.WarehouseName · @(item.LocationName ?? "Lokasyon yok")</dd>
                    <dt>Zimmetli personel</dt>
                    <dd>
                        @if (item.EmployeeId is not null)
                        {
                            <a href="personeller/@item.EmployeeId">@item.EmployeeName</a>
                            @if (item.OpenAssignmentId is not null) { <span class="muted"> · <a href="zimmetler/@item.OpenAssignmentId">@item.OpenAssignmentNo</a></span> }
                        }
                        else { <span class="muted">Yok</span> }
                    </dd>
                    <dt>Maliyet</dt><dd class="num">@(item.Cost is null ? "Girilmemiş" : Fmt.Money(item.Cost))</dd>
                    @if (item.Notes is not null) { <dt>Not</dt><dd>@item.Notes</dd> }
                </dl>
                @if (item.Fields.Count > 0)
                {
                    <div class="group-title">@item.CategoryName alanları <span class="tag custom">özel alan</span></div>
                    <dl class="kv">
                        @foreach (var f in item.Fields)
                        {
                            <dt>@f.Label @if (f.Archived) { <span class="tag">arşiv</span> }</dt>
                            <dd class="@(f.Type == FieldType.Text ? "mono" : "")">@(string.IsNullOrEmpty(f.Value) ? "—" : Fmt.FieldDisplay(f.Type, f.Value))</dd>
                        }
                    </dl>
                }
            </div>
        </section>
        <div class="stack">
            @if (lines is { Count: > 0 } || (canWrite && item.Status != ItemStatus.Retired))
            {
                <section class="card">
                    <div class="ch"><h2>Takılı hatlar</h2>@if (canWrite && item.Status != ItemStatus.Retired && (lines?.Count ?? 0) < 2) { <button class="btn sm" @onclick="OpenInstall">+ Hat tak</button> }</div>
                    <div class="cb" style="padding-block:4px">
                        @if (lines is null || lines.Count == 0) { <p class="muted">Bu cihazda kayıtlı hat yok. Telefon veya modem ise SIM takıldığında buradan bağlayın.</p> }
                        else
                        {
                            @foreach (var l in lines)
                            {
                                <div class="doc-row">
                                    <div class="grow"><a class="mono" href="hatlar/@l.Id"><b>@LineLabels.Number(l.Number)</b></a> · @l.Operator<span class="muted" style="display:block;font-size:12px">@l.LineType@(l.Tariff is null ? "" : " · " + l.Tariff) · @LineLabels.Status(l.Status)</span></div>
                                    @if (l.CanManage) { <button class="btn sm" disabled="@busy" @onclick="() => Uninstall(l)">Çıkar</button> }
                                </div>
                            }
                        }
                    </div>
                </section>
            }
            <section class="card">
                <div class="ch"><h2>Evraklar</h2></div>
                <div class="cb" style="padding-block:4px">
                    @if (item.Documents.Count == 0) { <p class="muted">Bu cihaz için henüz zimmet evrakı yok. Zimmet yapıldığında tutanak burada görünür.</p> }
                    @foreach (var doc in item.Documents)
                    {
                        <div class="doc-row">
                            <div class="doc-ic @(doc.Kind == DocumentKind.Signed ? "ok" : "")">@Ext(doc.ContentType)</div>
                            <div class="grow">
                                <b>@(doc.Kind == DocumentKind.Signed ? $"İmzalı kopya · sürüm {doc.Version}" : "Üretilen tutanak")</b>
                                <span class="muted" style="display:block;font-size:12px"><a href="zimmetler/@doc.AssignmentId">@doc.AssignmentNo</a> · @Fmt.DateTime(doc.At) · @doc.UserName</span>
                            </div>
                            <a class="btn sm" href="api/documents/@doc.Id" download>İndir</a>
                        </div>
                    }
                </div>
            </section>
            <section class="card">
                <div class="ch"><h2>Hareketler</h2></div>
                <div class="cb">
                    <ol class="timeline">
                        @foreach (var h in item.History)
                        {
                            <li style="--accent:@Color(h.Type)">
                                <b>@h.Text</b>
                                <span class="muted" style="font-size:12.5px">@Fmt.DateTime(h.At) · @h.UserName @if (h.Reference is not null) { <span> · <span class="mono">@h.Reference</span></span> }</span>
                            </li>
                        }
                    </ol>
                </div>
            </section>
        </div>
    </div>
}

@if (labels && item is not null)
{
    <LabelModal Query="@($"ids={item.Id}")" Description="@($"{item.Tag} için tek etiket basılacak.")" OnClose="() => labels = false" />
}

@if (installing)
{
    <Modal Title="Cihaza hat tak" OnClose="() => installing = false">
        <ChildContent>
            <ErrorNote Error="error" />
            @if (freeLines is null) { <div class="loading">Yükleniyor…</div> }
            else if (freeLines.Count == 0) { <div class="note">@item!.CompanyName şirketinde bir cihaza takılı olmayan hat yok. Önce <a href="hatlar">Hatlar</a> sayfasından ekleyin.</div> }
            else
            {
                <label class="fld" for="inst-line">Hat
                    <select id="inst-line" value="@lineId" @onchange="e => lineId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                        <option value="">Seçin</option>
                        @foreach (var l in freeLines) { <option value="@l.Id">@LineLabels.Number(l.Number) · @l.Operator@(l.HolderName is null ? "" : " · " + l.HolderName)</option> }
                    </select>
                </label>
                <p class="muted" style="font-size:12.5px">Hat cihaza takılınca cihazın zimmetlisi hattın kullanıcısı olarak görünür ve zimmet tutanağına yazılır.</p>
            }
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => installing = false">Vazgeç</button>
            <button class="btn pri" disabled="@(busy || lineId is null)" @onclick="Install">Tak</button>
        </Footer>
    </Modal>
}

@if (action is not null)
{
    <Modal Title="@ActionTitle" OnClose="() => action = null">
        <ChildContent>
            <form class="form" id="act" @onsubmit="Run">
                <label class="fld @(error?.For("note") is not null ? "err" : "")" for="act-note">
                    @(action is "maintenance/end" or "reactivate" ? "Açıklama (isteğe bağlı)" : "Açıklama")
                    <textarea id="act-note" @bind="note" placeholder="@(action == "maintenance" ? "Arıza ve servis bilgisi" : "")"></textarea>
                    @if (error?.For("note") is { } m) { <span class="err-msg">@m</span> }
                </label>
                @if (error is not null && error.For("note") is null) { <ErrorNote Error="error" /> }
            </form>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => action = null">Vazgeç</button>
            <button class="btn pri" type="submit" form="act" disabled="@busy">Kaydet</button>
        </Footer>
    </Modal>
}

@code {
    [Parameter] public Guid Id { get; set; }
    ItemDetail? item;
    ApiException? error;
    string? action, note;
    bool busy, labels, installing;
    List<PhoneLineRow>? lines, freeLines;
    Guid? lineId;

    protected override async Task OnParametersSetAsync() => await Load();

    async Task Load()
    {
        try
        {
            item = await Api.Get<ItemDetail>($"api/items/{Id}"); error = null;
            lines = await Api.Get<List<PhoneLineRow>>($"api/lines?itemId={Id}");
        }
        catch (ApiException ex) { error = ex; }
    }

    async Task OpenInstall()
    {
        installing = true; lineId = null; freeLines = null; error = null;
        try { freeLines = (await Api.Get<List<PhoneLineRow>>($"api/lines?companyId={item!.CompanyId}")).Where(l => l.ItemId is null && l.Status != LineStatus.Cancelled && l.CanManage).ToList(); }
        catch (ApiException ex) { error = ex; freeLines = []; }
    }

    async Task Install()
    {
        busy = true;
        try { await Api.Post<PhoneLineDetail>($"api/lines/{lineId}/install", new LineInstall(Id, null)); installing = false; Toasts.Show("Hat takıldı"); await Load(); }
        catch (ApiException ex) { error = ex; }
        finally { busy = false; }
    }

    async Task Uninstall(PhoneLineRow l)
    {
        busy = true;
        try { await Api.Post<PhoneLineDetail>($"api/lines/{l.Id}/install", new LineInstall(null, null)); Toasts.Show($"{LineLabels.Number(l.Number)} cihazdan çıkarıldı"); await Load(); }
        catch (ApiException ex) { error = ex; }
        finally { busy = false; }
    }

    void Open(string a) { action = a; note = null; error = null; }

    string ActionTitle => action switch
    {
        "maintenance" => "Bakıma al",
        "maintenance/end" => "Bakımdan dönüş",
        "retire" => "Kullanım dışı bırak",
        "reactivate" => "Tekrar kullanıma al",
        _ => ""
    };

    async Task Run()
    {
        busy = true;
        try
        {
            await Api.Post($"api/items/{Id}/{action}", new MaintenanceRequest(note ?? "", item!.Version));
            Toasts.Show(ActionTitle + " kaydedildi");
            action = null;
            await Load();
        }
        catch (ApiException ex) { error = ex; }
        finally { busy = false; }
    }

    static string Ext(string ct) => ct switch { "image/png" => "PNG", "image/jpeg" => "JPG", _ => "PDF" };
    static string Color(string type) => type switch
    {
        "Zimmet" => "var(--accent)", "İade" => "var(--ok)", "Bakım" => "var(--warn)", "Kayıt" => "var(--ok)",
        "Evrak" => "var(--move)", "Transfer" => "var(--move)", "Hat" => "var(--accent)", "Kullanım dışı" => "var(--muted)", _ => "var(--line)"
    };
}
