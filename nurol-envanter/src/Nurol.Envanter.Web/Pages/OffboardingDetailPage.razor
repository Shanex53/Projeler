@page "/ilisik-kesme/{Id:guid}"
@inject Api Api
@inject Toasts Toasts
@inject NavigationManager Nav

<PageTitle>@(d?.Case.No ?? "İlişik kesme") · Nurol Envanter</PageTitle>
@if (d is null)
{
    @if (error is not null) { <ErrorNote Error="error" /> } else { <div class="loading">Yükleniyor…</div> }
}
else
{
    var c = d.Case;
    var open = c.Status == OffboardingStatus.Open;
    <div class="head">
        <div class="t">
            <div class="crumb"><a href="ilisik-kesme">İlişik kesme</a> / @c.CompanyName</div>
            <h1>@c.EmployeeName</h1>
            <p><span class="mono">@c.No</span> · @(c.Department ?? "Birim yok") ·
                <span class="pill @(c.Status switch { OffboardingStatus.Open => "p-warn", OffboardingStatus.Completed => "p-ok", _ => "p-mute" })">@OffboardingLabels.Status(c.Status)</span></p>
        </div>
        <a class="btn" href="personeller/@c.EmployeeId">Personel kartı</a>
        @if (d.HasCertificate) { <a class="btn pri" href="api/offboarding/@c.Id/certificate" download>İlişik kesme belgesi (PDF)</a> }
        @if (d.CanManage)
        {
            <button class="btn danger" @onclick="() => cancelling = true">İptal et</button>
            <button class="btn pri" disabled="@(!d.CanComplete || busy)" title="@(d.CanComplete ? "" : "Önce tüm kalemler tamamlanmalı")" @onclick="Complete">İlişiği kes ve belge üret</button>
        }
    </div>
    <ErrorNote Error="error" />
    @if (open && d.Blockers.Count > 0)
    {
        <div class="note warn"><b>Kapatmak için bekleyenler:</b><ul>@foreach (var b in d.Blockers) { <li>@b</li> }</ul></div>
    }
    else if (open) { <div class="note">Tüm kalemler tamamlandı. “İlişiği kes ve belge üret” ile süreci kapatın; belge kapanış anındaki verilerle dondurulur.</div> }
    @if (c.Status == OffboardingStatus.Cancelled) { <div class="note">İptal: @d.CancelReason · @d.CompletedBy</div> }

    <div class="grid g2">
        <div class="stack">
            <section class="card">
                <div class="ch">
                    <h2>Cihazlar</h2><span class="tag">@d.Items.Count kaldı</span>
                    @if (d.CanManage && d.Items.Count > 0) { <a class="btn sm" href="zimmetler/iade?personel=@c.EmployeeId">İade al</a> }
                </div>
                <div class="tw">
                    <table>
                        <thead><tr><th>Etiket</th><th>Cihaz</th><th>Depo</th><th>Evrak</th></tr></thead>
                        <tbody>
                            @if (d.Items.Count == 0) { <tr><td colspan="4" class="empty">@(c.OpenItems > 0 ? "Kapsamınızdaki depolarda iade alınacak cihaz yok." : "Üzerinde cihaz kalmadı.")</td></tr> }
                            @foreach (var i in d.Items)
                            {
                                <tr class="click" @onclick='() => Nav.NavigateTo($"envanter/{i.Id}")'>
                                    <td class="mono"><b>@i.Tag</b></td><td>@i.ManufacturerName @i.ModelName<span class="sub">@i.CategoryName@(i.Serial is null ? "" : " · " + i.Serial)</span></td>
                                    <td>@i.WarehouseName</td><td><DocPill Missing="i.SignedDocumentMissing" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="card">
                <div class="ch"><h2>Hatlar</h2><span class="tag">@d.Lines.Count</span></div>
                <div class="tw">
                    <table>
                        <thead><tr><th>Numara</th><th>Nasıl</th><th></th></tr></thead>
                        <tbody>
                            @if (d.Lines.Count == 0) { <tr><td colspan="3" class="empty">Üzerinde hat kalmadı.</td></tr> }
                            @foreach (var l in d.Lines)
                            {
                                <tr>
                                    <td><a class="mono" href="hatlar/@l.Id"><b>@LineLabels.Number(l.Number)</b></a><span class="sub">@l.Operator@(l.Tariff is null ? "" : " · " + l.Tariff)</span></td>
                                    <td>@if (l.EmployeeId == c.EmployeeId) { <span>Doğrudan verildi</span>@if (l.ItemTag is not null) { <span class="sub">@l.ItemTag cihazında</span> } }
                                        else { <span>@l.ItemTag cihazında</span><span class="sub">Cihaz iade alınınca döner</span> }</td>
                                    <td class="right">@if (d.CanManage && l.EmployeeId == c.EmployeeId && l.CanManage) { <button class="btn sm" disabled="@busy" @onclick="() => TakeBack(l)">Geri al</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            @if (d.Returned.Count > 0)
            {
                <section class="card">
                    <div class="ch"><h2>İade alınanlar</h2><span class="tag">@d.Returned.Count</span></div>
                    <div class="tw">
                        <table>
                            <thead><tr><th>Tür</th><th>Belge / numara</th><th>Açıklama</th><th>Tarih</th></tr></thead>
                            <tbody>
                                @foreach (var r in d.Returned)
                                {
                                    <tr><td>@r.Kind</td><td class="mono">@r.Reference</td><td>@r.Text</td><td class="num">@Fmt.Date(r.At)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
        <div class="stack">
            <section class="card">
                <div class="ch"><h2>Görevler</h2><span class="tag">@d.Tasks.Count(t => t.Done) / @d.Tasks.Count</span></div>
                <div class="cb stack" style="gap:6px">
                    @if (d.Tasks.Count == 0) { <p class="muted" style="margin:0">Görev yok. Giriş kartı, anahtar, araç gibi teslim alınacakları ekleyebilirsiniz.</p> }
                    @foreach (var t in d.Tasks)
                    {
                        <div class="doc-row" style="padding-block:4px">
                            <input type="checkbox" id="@($"tk-{t.Id:N}")" checked="@t.Done" disabled="@(!d.CanManage || busy)" @onchange="e => Toggle(t, (bool)e.Value!)" />
                            <label class="grow" for="@($"tk-{t.Id:N}")"><span style="@(t.Done ? "text-decoration:line-through;color:var(--muted)" : "")">@t.Title</span>
                                @if (t.Done) { <span class="muted" style="display:block;font-size:12px">@t.DoneBy · @Fmt.DateTime(t.DoneAt)</span> }</label>
                            @if (d.CanManage) { <button class="btn sm" aria-label="Görevi sil" disabled="@busy" @onclick="() => RemoveTask(t)">✕</button> }
                        </div>
                    }
                    @if (d.CanManage)
                    {
                        <form class="row" style="gap:6px;margin-top:6px" @onsubmit="AddTask">
                            <label class="sr" for="tk-new">Yeni görev</label>
                            <input id="tk-new" class="sel-in" style="flex:1" @bind="newTask" placeholder="Ör. Giriş kartı teslim alındı" />
                            <button class="btn sm" type="submit" disabled="@(busy || string.IsNullOrWhiteSpace(newTask))">Ekle</button>
                        </form>
                    }
                </div>
            </section>
            <section class="card">
                <div class="ch"><h2>Süreç</h2></div>
                <div class="cb">
                    <dl class="kv">
                        <dt>Başlatan</dt><dd>@d.OpenedBy · @c.Source</dd>
                        <dt>Başlangıç</dt><dd>@Fmt.DateTime(c.OpenedAt)</dd>
                        <dt>Son çalışma günü</dt><dd>@(c.LastWorkingDay?.ToString("dd.MM.yyyy") ?? "—")</dd>
                        @if (c.CompletedAt is not null) { <dt>@(c.Status == OffboardingStatus.Completed ? "Kapatan" : "İptal eden")</dt><dd>@d.CompletedBy · @Fmt.DateTime(c.CompletedAt)</dd> }
                        <dt>Not</dt><dd>@(d.Note ?? "—")</dd>
                    </dl>
                    @if (d.CanManage) { <button class="btn sm" style="margin-top:10px" @onclick="EditInfo">Son gün ve notu düzenle</button> }
                </div>
            </section>
        </div>
    </div>
}

@if (cancelling)
{
    <Modal Title="Süreci iptal et" OnClose="() => cancelling = false">
        <ChildContent>
            <ErrorNote Error="error" />
            <label class="fld" for="ob-cancel">İptal nedeni<textarea id="ob-cancel" @bind="reason" placeholder="Ör. Personel ayrılmaktan vazgeçti"></textarea></label>
            <p class="muted" style="font-size:12.5px">İptal edilen süreç için belge üretilmez. Personel yeniden ayrılırsa yeni süreç açılır.</p>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => cancelling = false">Vazgeç</button>
            <button class="btn danger" disabled="@busy" @onclick="Cancel">İptal et</button>
        </Footer>
    </Modal>
}

@if (editingInfo)
{
    <Modal Title="Süreç bilgileri" OnClose="() => editingInfo = false">
        <ChildContent>
            <ErrorNote Error="error" />
            <label class="fld" for="ob-ld">Son çalışma günü<input id="ob-ld" type="date" @bind="lastDay" /></label>
            <label class="fld" for="ob-nt" style="margin-top:10px">Not<textarea id="ob-nt" @bind="note"></textarea></label>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => editingInfo = false">Vazgeç</button>
            <button class="btn pri" disabled="@busy" @onclick="SaveInfo">Kaydet</button>
        </Footer>
    </Modal>
}

@code {
    [Parameter] public Guid Id { get; set; }
    OffboardingDetail? d;
    ApiException? error;
    bool busy, cancelling, editingInfo;
    string? newTask, reason, note;
    DateOnly? lastDay;

    protected override async Task OnParametersSetAsync()
    {
        try { d = await Api.Get<OffboardingDetail>($"api/offboarding/{Id}"); }
        catch (ApiException ex) { error = ex; }
    }

    async Task Do(Func<Task<OffboardingDetail>> call, string? toast = null)
    {
        busy = true; error = null;
        try { d = await call(); if (toast is not null) Toasts.Show(toast); }
        catch (ApiException ex) { error = ex; }
        finally { busy = false; }
    }

    async Task AddTask()
    {
        var t = newTask; newTask = null;
        await Do(() => Api.Post<OffboardingDetail>($"api/offboarding/{Id}/tasks", new OffboardingTaskSave(t ?? "")));
    }

    Task Toggle(OffboardingTaskDto t, bool done) => Do(() => Api.Put<OffboardingDetail>($"api/offboarding/{Id}/tasks/{t.Id}", new OffboardingTaskToggle(done)));
    Task RemoveTask(OffboardingTaskDto t) => Do(() => Api.Delete<OffboardingDetail>($"api/offboarding/{Id}/tasks/{t.Id}"));

    async Task TakeBack(PhoneLineRow l)
    {
        busy = true; error = null;
        try
        {
            await Api.Post<PhoneLineDetail>($"api/lines/{l.Id}/assign", new LineAssign(null, $"İlişik kesme {d!.Case.No}"));
            d = await Api.Get<OffboardingDetail>($"api/offboarding/{Id}");
            Toasts.Show($"{LineLabels.Number(l.Number)} geri alındı");
        }
        catch (ApiException ex) { error = ex; }
        finally { busy = false; }
    }

    Task Complete() => Do(() => Api.Post<OffboardingDetail>($"api/offboarding/{Id}/complete", null), "İlişik kesildi; belge üretildi");

    async Task Cancel()
    {
        await Do(() => Api.Post<OffboardingDetail>($"api/offboarding/{Id}/cancel", new OffboardingCancel(reason ?? "")), "Süreç iptal edildi");
        if (error is null) cancelling = false;
    }

    void EditInfo() { lastDay = d!.Case.LastWorkingDay; note = d.Note; editingInfo = true; error = null; }

    async Task SaveInfo()
    {
        await Do(() => Api.Put<OffboardingDetail>($"api/offboarding/{Id}", new OffboardingStart(d!.Case.EmployeeId, lastDay, note)), "Kaydedildi");
        if (error is null) editingInfo = false;
    }
}
