@page "/personeller/{Id:guid}"
@inject Api Api
@inject Session Session
@inject Toasts Toasts
@inject NavigationManager Nav

<PageTitle>@(d?.Employee.FullName ?? "Personel") · Nurol Envanter</PageTitle>
@if (d is null)
{
    @if (error is not null) { <ErrorNote Error="error" /> } else { <div class="loading">Yükleniyor…</div> }
}
else
{
    var e = d.Employee;
    <div class="head">
        <div class="t">
            <div class="crumb"><a href="personeller">Personeller</a> / @e.CompanyName</div>
            <h1>@e.FullName</h1>
            <p>@(e.Title ?? "Unvan yok") · @(e.Department ?? "Birim yok") · @if (e.IsActive) { <span class="pill p-ok">Aktif</span> } else { <span class="pill p-mute">Pasif</span> }</p>
        </div>
        @if (Session.CanWrite)
        {
            <button class="btn" @onclick="() => form = EmployeeEditor.EmpForm.From(e, companies)">Düzenle</button>
            @if (d.OpenItems.Count > 0)
            {
                <a class="btn" href="zimmetler/iade?personel=@e.Id">İade al</a>
                <a class="btn" href="zimmetler/devir?personel=@e.Id">Devret</a>
            }
            @if (openCase is null) { <button class="btn" disabled="@busy" @onclick="StartOffboarding">İlişik kesme başlat</button> }
            @if (e.IsActive) { <a class="btn pri" href="zimmetler/yeni?personel=@e.Id">+ Zimmetle</a> }
        }
    </div>
    <ErrorNote Error="actionError" />
    @if (openCase is not null)
    {
        <div class="note warn"><b>İlişik kesme süreci açık</b> (<a class="mono" href="ilisik-kesme/@openCase.Id">@openCase.No</a>):
            @(openCase.OpenItems + openCase.OpenLines + openCase.PendingTasks == 0 ? "tüm kalemler tamam, süreç kapatılabilir." : $"{openCase.OpenItems} cihaz, {openCase.OpenLines} hat ve {openCase.PendingTasks} görev bekliyor.")</div>
    }
    else if (!e.IsActive && d.OpenItems.Count > 0) { <div class="note warn">Personel pasif durumda ama üzerinde @d.OpenItems.Count açık zimmet var.</div> }

    <div class="grid g2">
        <div class="stack">
            <section class="card">
                <div class="ch"><h2>Açık zimmetler</h2><span class="tag">@d.OpenItems.Count cihaz</span></div>
                <div class="tw">
                    <table>
                        <thead><tr><th>Etiket</th><th>Cihaz</th><th>Seri no</th><th>Evrak</th></tr></thead>
                        <tbody>
                            @if (d.OpenItems.Count == 0) { <tr><td colspan="4" class="empty">Üzerinde zimmetli cihaz yok.</td></tr> }
                            @foreach (var i in d.OpenItems)
                            {
                                <tr class="click" @onclick='() => Nav.NavigateTo($"envanter/{i.Id}")'>
                                    <td class="mono"><b>@i.Tag</b></td><td>@i.ManufacturerName @i.ModelName<span class="sub">@i.CategoryName</span></td>
                                    <td class="mono">@(i.Serial ?? "—")</td><td><DocPill Missing="i.SignedDocumentMissing" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="card">
                <div class="ch"><h2>Tutanak geçmişi</h2></div>
                <div class="tw">
                    <table>
                        <thead><tr><th>Tutanak</th><th>Tür</th><th>Depo</th><th class="right">Cihaz</th><th>İmzalı evrak</th></tr></thead>
                        <tbody>
                            @if (d.Assignments.Count == 0) { <tr><td colspan="5" class="empty">Tutanak yok.</td></tr> }
                            @foreach (var a in d.Assignments)
                            {
                                <tr class="click" @onclick='() => Nav.NavigateTo($"zimmetler/{a.Id}")'>
                                    <td class="mono">@a.No<span class="sub">@Fmt.DateTime(a.At)</span></td>
                                    <td><span class="pill @(a.Kind == AssignmentKind.Issue ? "p-info" : "p-ok")">@(a.Kind == AssignmentKind.Issue ? "Zimmet" : "İade")</span></td>
                                    <td>@a.WarehouseName</td><td class="num right">@a.ItemCount</td><td><DocPill Missing="!a.SignedUploaded" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
        <div class="stack">
            <section class="card">
                <div class="ch"><h2>Bilgiler</h2></div>
                <div class="cb">
                    <dl class="kv">
                        <dt>Şirket</dt><dd>@e.CompanyName</dd>
                        <dt>Sicil no</dt><dd class="mono">@(e.RegistryNo ?? "—")</dd>
                        <dt>E-posta</dt><dd>@(e.Email ?? "—")</dd>
                        <dt>Kaynak</dt><dd>@(e.Source == EmployeeSource.Directory ? "Active Directory" : "Elle kayıt")</dd>
                    </dl>
                </div>
            </section>
            <section class="card">
                <div class="ch"><h2>Hatlar</h2><span class="tag">@lines.Count</span></div>
                <div class="cb" style="padding-block:4px">
                    @if (lines.Count == 0) { <p class="muted">Kullandığı hat yok.</p> }
                    @foreach (var l in lines)
                    {
                        <div class="doc-row"><div class="grow"><a class="mono" href="hatlar/@l.Id"><b>@LineLabels.Number(l.Number)</b></a> · @l.Operator
                            <span class="muted" style="display:block;font-size:12px">@(l.EmployeeId == Id ? "Doğrudan verildi" : "Cihazda") @(l.ItemTag is null ? "" : "· " + l.ItemTag) @(l.Tariff is null ? "" : "· " + l.Tariff)</span></div></div>
                    }
                </div>
            </section>
            @if (pastCases.Count > 0)
            {
                <section class="card">
                    <div class="ch"><h2>İlişik kesme</h2></div>
                    <div class="cb" style="padding-block:4px">
                        @foreach (var oc in pastCases)
                        {
                            <div class="doc-row"><div class="grow"><a class="mono" href="ilisik-kesme/@oc.Id"><b>@oc.No</b></a> · @OffboardingLabels.Status(oc.Status)
                                <span class="muted" style="display:block;font-size:12px">@Fmt.Date(oc.OpenedAt)@(oc.CompletedAt is null ? "" : " – " + Fmt.Date(oc.CompletedAt.Value))</span></div>
                                @if (oc.Status == OffboardingStatus.Completed) { <a class="btn sm" href="api/offboarding/@oc.Id/certificate" download>Belge</a> }</div>
                        }
                    </div>
                </section>
            }
            <section class="card">
                <div class="ch"><h2>Sarf geçmişi</h2></div>
                <div class="cb" style="padding-block:4px">
                    @if (d.Consumption.Count == 0) { <p class="muted">Bu personele sarf çıkışı yapılmamış.</p> }
                    @foreach (var m in d.Consumption)
                    {
                        <div class="doc-row"><div class="grow"><b>@m.StockItemName</b> · <span class="num">@Fmt.Qty(Math.Abs(m.Quantity)) @m.Unit</span><span class="muted" style="display:block;font-size:12px">@Fmt.DateTime(m.At) · @m.WarehouseName @(m.Note is null ? "" : "· " + m.Note)</span></div></div>
                    }
                </div>
            </section>
        </div>
    </div>
}

@if (form is not null)
{
    <EmployeeEditor Form="form" Companies="companies" OnClose="() => form = null" OnSaved="Saved" />
}

@code {
    [Parameter] public Guid Id { get; set; }
    EmployeeDetail? d;
    List<CompanyDto> companies = [];
    EmployeeEditor.EmpForm? form;
    ApiException? error, actionError;
    List<PhoneLineRow> lines = [];
    List<OffboardingRow> pastCases = [];
    OffboardingRow? openCase;
    bool busy;

    protected override async Task OnParametersSetAsync()
    {
        await Load();
        try { companies = await Api.Get<List<CompanyDto>>("api/companies"); } catch (ApiException) { }
    }

    async Task Load()
    {
        try
        {
            d = await Api.Get<EmployeeDetail>($"api/employees/{Id}");
            lines = await Api.Get<List<PhoneLineRow>>($"api/lines?employeeId={Id}&status=Active");
            lines.AddRange((await Api.Get<List<PhoneLineRow>>($"api/lines?employeeId={Id}&status=Suspended")));
            pastCases = await Api.Get<List<OffboardingRow>>($"api/offboarding?employeeId={Id}");
            openCase = pastCases.FirstOrDefault(c => c.Status == OffboardingStatus.Open);
        }
        catch (ApiException ex) { error = ex; }
    }

    async Task StartOffboarding()
    {
        busy = true; actionError = null;
        try
        {
            var r = await Api.Post<System.Text.Json.JsonElement>("api/offboarding", new OffboardingStart(Id, null, null));
            Nav.NavigateTo($"ilisik-kesme/{r.GetProperty("id").GetGuid()}");
        }
        catch (ApiException ex) { actionError = ex; }
        finally { busy = false; }
    }

    async Task Saved() { form = null; Toasts.Show("Personel kaydedildi"); await Load(); }
}
