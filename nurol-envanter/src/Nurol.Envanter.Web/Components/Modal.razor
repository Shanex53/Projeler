<div class="modal-bg" @onclick="Close" @onclick:self="true">
    <div class="modal @(Wide ? "wide" : "")" role="dialog" aria-modal="true" aria-label="@Title" @onclick:stopPropagation="true">
        <div class="mh"><h2>@Title</h2><button class="btn sm" @onclick="Close" aria-label="Kapat">✕</button></div>
        <div class="mb">@ChildContent</div>
        @if (Footer is not null) { <div class="mf">@Footer</div> }
    </div>
</div>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Wide { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    Task Close() => OnClose.InvokeAsync();
}
