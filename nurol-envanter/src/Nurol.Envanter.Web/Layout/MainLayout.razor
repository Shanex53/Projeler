@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject NavigationManager Nav
@inject Toasts Toasts
@inject Api Api

@if (!ready)
{
    <div class="boot"><div class="brand-mark">NE</div><span>Oturum kontrol ediliyor…</span></div>
}
else
{
    <div class="app">
        <aside class="side">
            <a class="brand" href=""><div class="brand-mark">NE</div><div><b>Nurol Envanter</b><small>Demirbaş · Stok · Zimmet</small></div></a>
            <nav class="nav" aria-label="Ana menü">
                <NavLink href="" Match="NavLinkMatch.All"><Icon Name="genel" />Genel Bakış</NavLink>
                <NavLink href="envanter"><Icon Name="envanter" />Envanter</NavLink>
                <NavLink href="stok"><Icon Name="stok" />Stok</NavLink>
                <NavLink href="zimmetler"><Icon Name="zimmetler" />Zimmetler</NavLink>
                <NavLink href="transferler"><Icon Name="transferler" />Transferler</NavLink>
                <NavLink href="personeller"><Icon Name="personeller" />Personeller</NavLink>
                <NavLink href="ilisik-kesme"><Icon Name="ilisik" />İlişik kesme</NavLink>
                <NavLink href="hatlar"><Icon Name="hat" />Hatlar</NavLink>
                <NavLink href="yazicilar"><Icon Name="yazici" />Yazıcılar</NavLink>
                <NavLink href="okut"><Icon Name="okut" />Kod okut</NavLink>
                <div class="sep">Tanımlar</div>
                <NavLink href="kategoriler"><Icon Name="kategoriler" />Kategoriler ve Alanlar</NavLink>
                <NavLink href="depolar"><Icon Name="depolar" />Depolar</NavLink>
                <div class="sep">Sistem</div>
                <NavLink href="raporlar"><Icon Name="raporlar" />Raporlar</NavLink>
                @if (Session.CanWrite)
                {
                    <NavLink href="toplu-ekleme"><Icon Name="ekle" />Excel ile ekleme</NavLink>
                }
                @if (Session.IsSystemAdmin)
                {
                    <NavLink href="yonetim"><Icon Name="yonetim" />Yönetim</NavLink>
                }
            </nav>
            <div class="side-foot"><a href="hesabim" style="color:#8fb4f5">Hesabım ve bildirim ayarları</a></div>
        </aside>
        <div class="main">
            <header class="top">
                <form class="search" @onsubmit="Search" role="search">
                    <Icon Name="ara" Size="16" />
                    <label class="sr" for="global-q">Ara</label>
                    <input id="global-q" @bind="q" placeholder="Etiket, seri no, IMEI veya personel ara" />
                </form>
                <div class="sp"></div>
                <div class="user">
                    <div class="avatar">@Initials</div>
                    <a class="who" href="hesabim" style="color:inherit;text-decoration:none"><b>@Session.Me?.DisplayName</b><br /><span class="muted" style="font-size:11.5px">@Session.RoleLabel</span></a>
                    <button class="btn sm" @onclick="Logout">Çıkış</button>
                </div>
            </header>
            <main class="view">@Body</main>
        </div>
    </div>
}
@if (Toasts.Message is not null)
{
    <div class="toast" role="status">@Toasts.Message</div>
}

@code {
    bool ready;
    string? q;

    string Initials => string.Concat((Session.Me?.DisplayName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpper(s[0])));

    protected override async Task OnInitializedAsync()
    {
        Toasts.Changed += Refresh;
        Session.Changed += Refresh;
        if (!await Session.EnsureAsync())
        {
            var back = Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo(string.IsNullOrEmpty(back) ? "giris" : $"giris?donus={Uri.EscapeDataString(back)}");
            return;
        }
        ready = true;
    }

    void Refresh() => InvokeAsync(StateHasChanged);

    // Okutulan veya yazılan kod tek bir cihaza denk geliyorsa doğrudan cihaza gider; değilse listede arar.
    async Task Search()
    {
        if (string.IsNullOrWhiteSpace(q)) return;
        var term = q.Trim();
        try
        {
            var hit = await Api.Get<LookupResult>($"api/items/lookup?code={Uri.EscapeDataString(term)}");
            q = null;
            Nav.NavigateTo($"envanter/{hit.ItemId}");
            return;
        }
        catch (ApiException) { }
        Nav.NavigateTo($"envanter?q={Uri.EscapeDataString(term)}");
    }

    async Task Logout()
    {
        await Session.LogoutAsync();
        Nav.NavigateTo("giris", forceLoad: true);
    }

    public void Dispose()
    {
        Toasts.Changed -= Refresh;
        Session.Changed -= Refresh;
    }
}
