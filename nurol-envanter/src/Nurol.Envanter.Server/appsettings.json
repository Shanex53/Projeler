{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Storage": {
    "Provider": "S3",
    "Bucket": "nurol-envanter",
    "ForcePathStyle": true
  },
  "Security": {
    "SecureCookies": true
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
